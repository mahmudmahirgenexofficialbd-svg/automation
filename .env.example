PORT=3001

# Gemini API
GEMINI_API_KEY=your_gemini_api_key_here

# Social Media Platform Keys (Add these as you configure each platform)

# Facebook Page
FB_PAGE_ID=your_facebook_page_id
FB_PAGE_ACCESS_TOKEN=your_facebook_page_access_token

# Instagram Business (Linked to Facebook Page)
IG_USER_ID=your_instagram_user_id
# Instagram uses the same FB_PAGE_ACCESS_TOKEN if set up correctly via Graph API

# LinkedIn
LINKEDIN_CLIENT_ID=your_linkedin_client_id
LINKEDIN_CLIENT_SECRET=your_linkedin_client_secret
LINKEDIN_ACCESS_TOKEN=your_linkedin_access_token
LINKEDIN_PERSON_URN=your_linkedin_person_or_organization_urn

# X (Twitter)
X_API_KEY=your_x_api_key
X_API_KEY_SECRET=your_x_api_key_secret
X_ACCESS_TOKEN=your_x_access_token
X_ACCESS_TOKEN_SECRET=your_x_access_token_secret
